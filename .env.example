# ── Merchant application (/apply → /api/apply) ───────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables (Production + Preview).
# For local testing, copy to .env.local (git-ignored).

# Resend (https://resend.com) — API key from the dashboard. Free tier is plenty.
RESEND_API_KEY=re_xxxxxxxxx

# Password sales uses to open the encrypted application PDFs. Pick something long;
# share it with the team out-of-band (not by email). Changing it only affects new submissions.
APPLICATION_PDF_PASSWORD=

# Where applications are delivered. Defaults to sales@321swipe.com.
# APPLICATION_TO=sales@321swipe.com

# Sender. The domain must be verified in Resend (add the DNS records it shows you).
# APPLICATION_FROM="321 Swipe <applications@321swipe.com>"

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile), free bot protection.
# Optional: leave both blank to run without it (honeypot + timing + throttle still apply).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
